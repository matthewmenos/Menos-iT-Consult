# Postgres (required for the backend API, auth + blog content) — Vercel injects POSTGRES_URL automatically
POSTGRES_URL=postgresql://user:pass@host:5432/menos_it

# Mail (Nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# Where enquiries are delivered
RECIPIENT_EMAIL=minnahmat50@gmail.com

# Server
PORT=3000

# Cookie signing secret — required, change to a long random string
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login password (username: admin). On first boot the app hashes this
# into the `admin` table automatically — `node migrate.js` is only needed if
# you prefer to seed manually from your machine.
ADMIN_PASSWORD=change-me-before-going-live

# Runtime — `production` enables secure (HTTPS-only) cookies (used behind Vercel TLS)
NODE_ENV=development

# ── Cloudflare R2 (media storage) ────────────────────────────────────────────
# When all three credentials are set, every image uploaded in the admin
# dashboard is stored in your R2 bucket instead of the Postgres `images`
# table. Leave unset to keep storing bytes in Postgres (legacy mode).
#   R2_ACCOUNT_ID     Account ID from the Cloudflare dashboard (right sidebar)
#   R2_ACCESS_KEY_ID  R2 API token access key (R2 → Manage R2 API Tokens)
#   R2_SECRET_ACCESS_KEY  R2 API token secret
#   R2_BUCKET         Bucket name, e.g. menosit-media
#   R2_PUBLIC_BASE    Optional. The bucket's public base URL (custom domain
#                     attached in R2 → Settings, e.g. https://media.menosit.com,
#                     or the r2.dev URL once "Allow public access" is enabled).
#                     When set, uploaded images get permanent CDN URLs served
#                     straight from R2; when omitted they are proxied through
#                     GET /api/images/:id instead.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE=